#!/usr/bin/env bash

## Description: Start DDEV backend environment and launch React frontend dev server
## Usage: dev
## UsageExample: ddev dev

# Ensure DDEV services are started
if ! ddev describe >/dev/null 2>&1; then
    echo "Starting DDEV services..."
    ddev start
fi

# Check if frontend node_modules exists, install if missing
if [ -f "$DDEV_APPROOT/frontend/package.json" ] && [ ! -d "$DDEV_APPROOT/frontend/node_modules" ]; then
    echo "Installing frontend dependencies..."
    ddev exec --dir /var/www/html/frontend npm install
fi

# Ensure Vite daemon is running
ddev exec supervisorctl start webextradaemons:vite >/dev/null 2>&1

echo "🚀 Servidor React Frontend activo en: http://localhost:5173"
echo "Mostrando logs en vivo (Presiona Ctrl+C para salir de los logs; el servidor seguirá corriendo):"
ddev logs -s web -f